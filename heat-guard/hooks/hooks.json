{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "/usr/bin/python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/heat_check.py"],
            "timeoutMs": 15000,
            "statusMessage": "检查本机温度"
          }
        ]
      }
    ]
  }
}
